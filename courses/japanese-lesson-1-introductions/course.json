  "grammar": [
    {
      "id": "grammar-a-wa-b-desu",
      "title": "A は B です — polite identification",
      "type": "expression",
      "input": ["Noun"],
      "structure": "A + は + B + です",
      "explanation": "Use A は B です to identify or describe A as B. In this lesson it is used for names and nationalities. は marks the topic and is pronounced わ as a particle.",
      "examples": [
        { "sentence": "私はゆうたです。", "translation": "I am Yuuta.", "breakdown": ["私", "は", "ゆうた", "です。"] },
        { "sentence": "私はマリアです。", "translation": "I am Maria.", "breakdown": ["私", "は", "マリア", "です。"] },
        { "sentence": "私は日本人です。", "translation": "I am Japanese.", "breakdown": ["私", "は", "日本人", "です。"] }
      ]
    },
    {
      "id": "grammar-a-wa-b-janai-desu",
      "title": "A は B じゃないです — polite negative identification",
      "type": "expression",
      "input": ["Noun"],
      "structure": "A + は + B + じゃないです",
      "explanation": "Use A は B じゃないです to say politely that A is not B. The lesson practices this with nationalities.",
      "examples": [
        { "sentence": "ゆうたさんはメキシコ人じゃないです。", "translation": "Yuuta is not Mexican.", "breakdown": ["ゆうたさん", "は", "メキシコ人", "じゃないです。"] },
        { "sentence": "マリアさんは日本人じゃないです。", "translation": "Maria is not Japanese.", "breakdown": ["マリアさん", "は", "日本人", "じゃないです。"] },
        { "sentence": "私はアメリカ人じゃないです。", "translation": "I am not American.", "breakdown": ["私", "は", "アメリカ人", "じゃないです。"] }
      ]
    },
    {
      "id": "grammar-desu-ka",
      "title": "〜ですか — polite questions",
      "type": "expression",
      "input": ["Noun"],
      "structure": "Statement + か",
      "explanation": "Add か to a polite です statement to ask a question. The lesson practices yes/no answers and a choice pattern such as A ですか、B ですか.",
      "examples": [
        { "sentence": "ゆうたさんは日本人ですか。", "translation": "Is Yuuta Japanese?", "breakdown": ["ゆうたさん", "は", "日本人", "ですか。"] },
        { "sentence": "ゆうたさんはメキシコ人ですか。", "translation": "Is Yuuta Mexican?", "breakdown": ["ゆうたさん", "は", "メキシコ人", "ですか。"] },
        { "sentence": "ゆうたさんは日本人ですか、アメリカ人ですか。", "translation": "Is Yuuta Japanese or American?", "breakdown": ["ゆうたさん", "は", "日本人", "ですか、", "アメリカ人", "ですか。"] }
      ]
    },
    {
      "id": "grammar-dokono-hito",
      "title": "どこの人ですか — asking where someone is from",
      "type": "expression",
      "input": ["Noun"],
      "structure": "Person + は + どこの人 + ですか",
      "explanation": "Use どこの人ですか to ask what country or place someone is from. The lesson answers with a nationality, for example メキシコ人です.",
      "examples": [
        { "sentence": "マリアさんはどこの人ですか。", "translation": "Where is Maria from?", "breakdown": ["マリアさん", "は", "どこの人", "ですか。"] },
        { "sentence": "メキシコ人です。", "translation": "She is Mexican.", "breakdown": ["メキシコ人", "です。"] }
      ]
    }
  ],

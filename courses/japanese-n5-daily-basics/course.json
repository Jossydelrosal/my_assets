  "grammar": [
    {
      "id": "grammar-wa",
      "title": "は — topic marker",
      "type": "particle",
      "input": ["Noun"],
      "structure": "Topic + は + comment",
      "explanation": "は marks what the sentence is about. It is written は but pronounced わ when used as the topic particle.",
      "examples": [
        { "sentence": "私は学生です。", "translation": "I am a student.", "breakdown": ["私", "は", "学生", "です。"] },
        { "sentence": "先生は日本語を話します。", "translation": "The teacher speaks Japanese.", "breakdown": ["先生", "は", "日本語を", "話します。"] }
      ]
    },
    {
      "id": "grammar-desu",
      "title": "です — polite copula",
      "type": "expression",
      "input": ["Noun", "Na-Adjective"],
      "structure": "Noun / Na-Adjective + です",
      "explanation": "です is a polite sentence ending often used to state identity or description.",
      "examples": [
        { "sentence": "私は学生です。", "translation": "I am a student.", "breakdown": ["私は", "学生", "です。"] },
        { "sentence": "これは本です。", "translation": "This is a book.", "breakdown": ["これは", "本", "です。"] }
      ]
    },
    {
      "id": "grammar-no",
      "title": "の — noun connection / possession",
      "type": "particle",
      "input": ["Noun"],
      "structure": "Noun A + の + Noun B",
      "explanation": "の connects nouns. It commonly shows possession, belonging, or a descriptive relationship.",
      "examples": [
        { "sentence": "これは私の本です。", "translation": "This is my book.", "breakdown": ["これは", "私", "の", "本です。"] },
        { "sentence": "日本語の本です。", "translation": "It is a Japanese-language book.", "breakdown": ["日本語", "の", "本です。"] }
      ]
    },
    {
      "id": "grammar-o",
      "title": "を — direct object marker",
      "type": "particle",
      "input": ["Noun"],
      "structure": "Object + を + Verb",
      "explanation": "を marks the direct object of an action. It is normally pronounced お in modern Japanese.",
      "examples": [
        { "sentence": "水を飲みます。", "translation": "I drink water.", "breakdown": ["水", "を", "飲みます。"] },
        { "sentence": "本を読みます。", "translation": "I read a book.", "breakdown": ["本", "を", "読みます。"] }
      ]
    },
    {
      "id": "grammar-ni",
      "title": "に — destination / target marker",
      "type": "particle",
      "input": ["Noun"],
      "structure": "Destination / target + に + Verb",
      "explanation": "に can mark a destination or target of movement and many other relationships. This starter deck focuses on destination usage.",
      "examples": [
        { "sentence": "学校に行きます。", "translation": "I go to school.", "breakdown": ["学校", "に", "行きます。"] },
        { "sentence": "友達は家に来ます。", "translation": "My friend comes to my house.", "breakdown": ["友達は", "家", "に", "来ます。"] }
      ]
    }
  ],

  "grammar": [
    {
      "id": "grammar-a-no-b",
      "title": "A の B — noun relationship / possession",
      "type": "particle",
      "input": ["Noun"],
      "structure": "A + の + B",
      "explanation": "の connects two nouns. In this lesson it identifies relationships such as whose friend someone is: ゆうたの友達 means 'Yuuta's friend'.",
      "examples": [
        { "sentence": "たけしはゆうたの友達です。", "translation": "Takeshi is Yuuta's friend.", "breakdown": ["たけし", "は", "ゆうた", "の", "友達", "です。"] },
        { "sentence": "アンナはマリアの友達です。", "translation": "Anna is Maria's friend.", "breakdown": ["アンナ", "は", "マリア", "の", "友達", "です。"] },
        { "sentence": "こちらは私の友達です。", "translation": "This is my friend.", "breakdown": ["こちら", "は", "私", "の", "友達", "です。"] }
      ]
    },
    {
      "id": "grammar-mo",
      "title": "も — also / too",
      "type": "particle",
      "input": ["Noun"],
      "structure": "A + も + B + です",
      "explanation": "も marks that the same statement also applies to A. The lesson uses it for shared status and nationality.",
      "examples": [
        { "sentence": "彼女も学生です。", "translation": "She is also a student.", "breakdown": ["彼女", "も", "学生", "です。"] },
        { "sentence": "たけしも日本人です。", "translation": "Takeshi is also Japanese.", "breakdown": ["たけし", "も", "日本人", "です。"] },
        { "sentence": "私もメキシコ人です。", "translation": "I am also Mexican.", "breakdown": ["私", "も", "メキシコ人", "です。"] }
      ]
    },
    {
      "id": "grammar-tachi",
      "title": "～たち — making a group",
      "type": "expression",
      "input": ["Noun"],
      "structure": "Person / pronoun + たち",
      "explanation": "Attach たち to a person word or pronoun to refer to that person and their group. The lesson builds 私たち, 彼たち, and 彼女たち.",
      "examples": [
        { "sentence": "私たちはメキシコ人です。", "translation": "We are Mexican.", "breakdown": ["私", "たち", "は", "メキシコ人", "です。"] },
        { "sentence": "彼たちはメキシコ人です。", "translation": "They are Mexican.", "breakdown": ["彼", "たち", "は", "メキシコ人", "です。"] },
        { "sentence": "彼女たち", "translation": "They / those women", "breakdown": ["彼女", "たち"] }
      ]
    },
    {
      "id": "grammar-dare-no",
      "title": "だれの B ですか — asking whose",
      "type": "expression",
      "input": ["Noun"],
      "structure": "Person + は + だれ + の + B + ですか",
      "explanation": "Use だれの before a noun to ask who that noun is connected to or belongs to. The lesson asks たけしはだれの友達ですか and answers ゆうたの友達です.",
      "examples": [
        { "sentence": "たけしはだれの友達ですか。", "translation": "Whose friend is Takeshi?", "breakdown": ["たけし", "は", "だれ", "の", "友達", "ですか。"] },
        { "sentence": "ゆうたの友達です。", "translation": "He is Yuuta's friend.", "breakdown": ["ゆうた", "の", "友達", "です。"] }
      ]
    }
  ],

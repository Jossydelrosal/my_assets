  "grammar": [
    {
      "id": "grammar-a-wa-b-desu",
      "title": "A は B です — polite identification",
      "type": "expression",
      "input": ["Noun"],
      "structure": "A + は + B + です",
      "explanation": "Use A は B です to identify or describe A as B. In this lesson it is used for names and nationalities. は marks the topic and is pronounced わ as a particle.",
      "tags": ["course:japanese", "jlpt:N5", "lesson:1"],
      "examples": [
        { "sentence": "私はゆうたです。", "translation": "I am Yuuta.", "breakdown": ["私", "は", "ゆうた", "です。"] },
        { "sentence": "私はマリアです。", "translation": "I am Maria.", "breakdown": ["私", "は", "マリア", "です。"] },
        { "sentence": "私は日本人です。", "translation": "I am Japanese.", "breakdown": ["私", "は", "日本人", "です。"] }
      ]
    },
    {
      "id": "grammar-a-wa-b-janai-desu",
      "title": "A は B じゃないです — polite negative identification",
      "type": "expression",
      "input": ["Noun"],
      "structure": "A + は + B + じゃないです",
      "explanation": "Use A は B じゃないです to say politely that A is not B. The lesson practices this with nationalities.",
      "tags": ["course:japanese", "jlpt:N5", "lesson:1"],
      "examples": [
        { "sentence": "ゆうたさんはメキシコ人じゃないです。", "translation": "Yuuta is not Mexican.", "breakdown": ["ゆうたさん", "は", "メキシコ人", "じゃないです。"] },
        { "sentence": "マリアさんは日本人じゃないです。", "translation": "Maria is not Japanese.", "breakdown": ["マリアさん", "は", "日本人", "じゃないです。"] },
        { "sentence": "私はアメリカ人じゃないです。", "translation": "I am not American.", "breakdown": ["私", "は", "アメリカ人", "じゃないです。"] }
      ]
    },
    {
      "id": "grammar-desu-ka",
      "title": "〜ですか — polite questions",
      "type": "expression",
      "input": ["Noun"],
      "structure": "Statement + か",
      "explanation": "Add か to a polite です statement to ask a question. The lesson practices yes/no answers and a choice pattern such as A ですか、B ですか.",
      "tags": ["course:japanese", "jlpt:N5", "lesson:1"],
      "examples": [
        { "sentence": "ゆうたさんは日本人ですか。", "translation": "Is Yuuta Japanese?", "breakdown": ["ゆうたさん", "は", "日本人", "ですか。"] },
        { "sentence": "ゆうたさんはメキシコ人ですか。", "translation": "Is Yuuta Mexican?", "breakdown": ["ゆうたさん", "は", "メキシコ人", "ですか。"] },
        { "sentence": "ゆうたさんは日本人ですか、アメリカ人ですか。", "translation": "Is Yuuta Japanese or American?", "breakdown": ["ゆうたさん", "は", "日本人", "ですか、", "アメリカ人", "ですか。"] }
      ]
    },
    {
      "id": "grammar-dokono-hito",
      "title": "どこの人ですか — asking where someone is from",
      "type": "expression",
      "input": ["Noun"],
      "structure": "Person + は + どこの人 + ですか",
      "explanation": "Use どこの人ですか to ask what country or place someone is from. The lesson answers with a nationality, for example メキシコ人です.",
      "tags": ["course:japanese", "jlpt:N5", "lesson:1"],
      "examples": [
        { "sentence": "マリアさんはどこの人ですか。", "translation": "Where is Maria from?", "breakdown": ["マリアさん", "は", "どこの人", "ですか。"] },
        { "sentence": "メキシコ人です。", "translation": "She is Mexican.", "breakdown": ["メキシコ人", "です。"] }
      ]
    },
    {
      "id": "grammar-a-no-b",
      "title": "A の B — noun relationship / possession",
      "type": "particle",
      "input": ["Noun"],
      "structure": "A + の + B",
      "explanation": "の connects two nouns. In this lesson it identifies relationships such as whose friend someone is: ゆうたの友達 means 'Yuuta's friend'.",
      "tags": ["course:japanese", "jlpt:N5", "lesson:2"],
      "examples": [
        { "sentence": "たけしはゆうたの友達です。", "translation": "Takeshi is Yuuta's friend.", "breakdown": ["たけし", "は", "ゆうた", "の", "友達", "です。"] },
        { "sentence": "アンナはマリアの友達です。", "translation": "Anna is Maria's friend.", "breakdown": ["アンナ", "は", "マリア", "の", "友達", "です。"] },
        { "sentence": "こちらは私の友達です。", "translation": "This is my friend.", "breakdown": ["こちら", "は", "私", "の", "友達", "です。"] }
      ]
    },
    {
      "id": "grammar-mo",
      "title": "も — also / too",
      "type": "particle",
      "input": ["Noun"],
      "structure": "A + も + B + です",
      "explanation": "も marks that the same statement also applies to A. The lesson uses it for shared status and nationality.",
      "tags": ["course:japanese", "jlpt:N5", "lesson:2"],
      "examples": [
        { "sentence": "彼女も学生です。", "translation": "She is also a student.", "breakdown": ["彼女", "も", "学生", "です。"] },
        { "sentence": "たけしも日本人です。", "translation": "Takeshi is also Japanese.", "breakdown": ["たけし", "も", "日本人", "です。"] },
        { "sentence": "私もメキシコ人です。", "translation": "I am also Mexican.", "breakdown": ["私", "も", "メキシコ人", "です。"] }
      ]
    },
    {
      "id": "grammar-tachi",
      "title": "～たち — making a group",
      "type": "expression",
      "input": ["Noun"],
      "structure": "Person / pronoun + たち",
      "explanation": "Attach たち to a person word or pronoun to refer to that person and their group. The lesson builds 私たち, 彼たち, and 彼女たち.",
      "tags": ["course:japanese", "jlpt:N5", "lesson:2"],
      "examples": [
        { "sentence": "私たちはメキシコ人です。", "translation": "We are Mexican.", "breakdown": ["私", "たち", "は", "メキシコ人", "です。"] },
        { "sentence": "彼たちはメキシコ人です。", "translation": "They are Mexican.", "breakdown": ["彼", "たち", "は", "メキシコ人", "です。"] },
        { "sentence": "彼女たち", "translation": "They / those women", "breakdown": ["彼女", "たち"] }
      ]
    },
    {
      "id": "grammar-dare-no",
      "title": "だれの B ですか — asking whose",
      "type": "expression",
      "input": ["Noun"],
      "structure": "Person + は + だれ + の + B + ですか",
      "explanation": "Use だれの before a noun to ask who that noun is connected to or belongs to. The lesson asks たけしはだれの友達ですか and answers ゆうたの友達です.",
      "tags": ["course:japanese", "jlpt:N5", "lesson:2"],
      "examples": [
        { "sentence": "たけしはだれの友達ですか。", "translation": "Whose friend is Takeshi?", "breakdown": ["たけし", "は", "だれ", "の", "友達", "ですか。"] },
        { "sentence": "ゆうたの友達です。", "translation": "He is Yuuta's friend.", "breakdown": ["ゆうた", "の", "友達", "です。"] }
      ]
    }
  ],
